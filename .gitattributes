# Auto-normalize line endings (Windows/Mac/Linux safe)
* text=auto

# Force LF for web source files
*.ts text eol=lf
*.tsx text eol=lf
*.js text eol=lf
*.jsx text eol=lf
*.css text eol=lf
*.json text eol=lf
*.md text eol=lf
*.html text eol=lf
*.svg text eol=lf

# Binary files (don't touch)
*.png binary
*.jpg binary
*.ico binary
*.woff binary
*.woff2 binary
